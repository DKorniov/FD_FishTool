     <property name="styleSheet">
      <string>
       /* Глобальный стиль для всех QPushButton внутри этой группы */
       QPushButton {
        background-color: #4f4f4f; /* Базовый цвет фона (темно-серый) */
        color: white; /* Цвет текста */
        border: 2px solid #3d3d3d; /* Небольшая граница */
        border-radius: 10px; /* Сильное скругление углов (как у GUI сверху) */
        font-weight: bold;
        padding: 5px;
       }

       /* Изменяем цвет границы для имитации подсветки */
       QPushButton:hover {
        background-color: #5f5f5f; /* Чуть светлее при наведении */
        border: 2px solid #2e86c1; /* Синяя граница (в цвет главной кнопки) */
       }

       /* Эффект нажатия */
       QPushButton:pressed {
        background-color: #3d3d3d; /* Самый темный при нажатии */
        padding-left: 7px; padding-top: 7px; /* Сдвиг текста */
       }
      </string>
