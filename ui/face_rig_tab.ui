         <property name="styleSheet">
          <string notr="true">/* Базовый стиль для всех кнопок селектора */
QPushButton {
    background-color: #444444;
    color: white;
    border-radius: 2px;
    border: 1px solid #333333;
    font-weight: bold;
}

/* Цвет при наведении */
QPushButton:hover {
    background-color: #555555;
    border: 1px solid #777777;
}

/* Стили для конкретных групп кнопок (по тексту на кнопке) */
QPushButton[text*=&quot;R_&quot;] { background-color: #2484d6; }
QPushButton[text*=&quot;L_&quot;] { background-color: #d02173; }
QPushButton[text*=&quot;Brow&quot;] { background-color: #9d53d7; }
QPushButton[text*=&quot;Lip&quot;], QPushButton[text=&quot;Jaw&quot;], QPushButton[text=&quot;Sync&quot;], QPushButton[text=&quot;Emote&quot;] { background-color: #d6bf55; }
QPushButton[text=&quot;Teeth&quot;] { background-color: #a0a0a0; }
      </string>
