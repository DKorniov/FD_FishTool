               <string notr="true">QPushButton {
    text-align: left;          /* Текст слева, а не по центру */
    padding-left: 25px;        /* Отступ от левого края */
    font-size: 11pt;           /* Крупный шрифт */
    font-weight: bold;         /* Жирный текст */
    background-color: #444444; /* Темно-серый фон */
    border: 1px solid #2b2b2b;
    border-radius: 2px;
    min-height: 28px;          /* Делаем кнопку высокой */
}

QPushButton:hover {
    background-color: #555555; /* Подсветка при наведении */
}

QPushButton:checked {
    background-color: #3b5c75; /* Синеватый фон для открытого блока (как в Maya) */
    color: white;
}</string>
